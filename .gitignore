# ──────────────────────────────────────────────
# Mobile (React Native / Expo) — mobile/
# ──────────────────────────────────────────────
mobile/node_modules/
mobile/node_modules_old/
mobile/.expo/
mobile/dist/
mobile/web-build/
mobile/expo-env.d.ts
mobile/.env

# native build artifacts
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# metro
.metro-health-check*

# debug logs
npm-debug.*
yarn-debug.*
yarn-error.*

# typescript
*.tsbuildinfo

# ──────────────────────────────────────────────
# Backend (FastAPI / Python) — backend/
# ──────────────────────────────────────────────
backend/venv/
backend/.env
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/

# ──────────────────────────────────────────────
# Banco de dados — nunca commitar
# ──────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ──────────────────────────────────────────────
# Geral
# ──────────────────────────────────────────────
.DS_Store
*.pem
.env
.env*.local

# test artifacts
*_final.txt
*_warnings.txt
lint_*.txt
tsc_*.txt

# sql scripts
*.sql

# migration/utility scripts (contêm credenciais)
backend/migrate_*.py
backend/generate_sql_dump.py
backend/test_connection.py
backend/import_data*.py
backend/*.json

# tunnel/server logs
server/tunnel_url*.txt
server/*.txt
