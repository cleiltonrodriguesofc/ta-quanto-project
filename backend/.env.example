# === Banco de Dados ===
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/taquanto

# === Autenticação JWT ===
JWT_SECRET_KEY=your-strong-random-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# === APIs de Produto (segredos somente no backend/Render) ===
COSMOS_API_TOKEN=
COSMOS_API_URL=https://api.cosmos.bluesoft.com.br/gtins
GO_UPC_API_KEY=

# === Atualização automática do catálogo (tarefa dentro do FastAPI) ===
PRODUCT_CATALOG_SYNC_ENABLED=true
PRODUCT_CATALOG_SYNC_INTERVAL_SECONDS=86400
PRODUCT_CATALOG_SYNC_START_DELAY_SECONDS=60
PRODUCT_CATALOG_SYNC_RETRY_SECONDS=900
PRODUCT_CATALOG_CATEGORIES=en:beverages,en:dairy-products,en:snacks,en:breakfast-cereals,en:plant-based-foods
PRODUCT_CATALOG_PAGES_PER_RUN=1
PRODUCT_CATALOG_REQUEST_INTERVAL_SECONDS=6
TAQUANTO_CONTACT_URL=https://github.com/cleiltonrodriguesofc/ta-quanto-project

# === Server ===
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
