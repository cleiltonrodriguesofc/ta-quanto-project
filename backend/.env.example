# === Banco de Dados ===
# PostgreSQL — qualquer provedor: Supabase, Neon, RDS, self-hosted VPS
# Formato: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/taquanto

# === Autenticação JWT (auth próprio — sem Supabase Auth) ===
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-strong-random-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# === APIs de Produto ===
# A busca de nome/imagem de produto (Cosmos, OpenFoodFacts, GoUPC, etc.)
# é feita DIRETAMENTE no mobile para evitar latencia de rede extra.
# Veja mobile/.env para as variáveis de produto.

# === Server ===
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
